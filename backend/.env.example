# ── Serveur ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# ── Secrets : valeurs factices pour le développement local. Aucun vrai secret dans ce fichier. ──
# Pour autre chose qu'un test local, remplacez-les par des valeurs aléatoires (ex. : openssl rand -base64 16).
APP_KEYS=dev-app-key-1,dev-app-key-2,dev-app-key-3,dev-app-key-4
API_TOKEN_SALT=dev-only-api-token-salt
ADMIN_JWT_SECRET=dev-only-admin-jwt-secret
TRANSFER_TOKEN_SALT=dev-only-transfer-token-salt
JWT_SECRET=dev-only-jwt-secret
ENCRYPTION_KEY=dev-only-encryption-key

# ── Données de démonstration (utilisateurs, catégories, discussions) ──
# Exécuté uniquement si la base est vide. Mettre "false" pour désactiver.
SEED_ON_BOOT=true

# ── Option A : SQLite (par défaut, aucune installation) ──────────────
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ── Option B : PostgreSQL (docker compose up -d à la racine) ─────────
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=lerevenu
# DATABASE_USERNAME=lerevenu
# DATABASE_PASSWORD=lerevenu_dev
# DATABASE_SSL=false
